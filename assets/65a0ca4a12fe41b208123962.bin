<div class='section gray editor'>
<div class='inner'>
<div class='container'>
<div class='profile-row'>
<div class='ten columns center'>
<div class='imac-wrapper'>
<div class='imac'>
<div class='imac-inner'>
<video autoplay='autoplay' class='lazy' data-poster='https://static-assets.strikinglycdn.com/images/landing4/editor.jpg' loop='loop' muted='muted' preload='none'>
<source src='//uploads.strikinglycdn.com/static/landing/editor.webm' type='video/webm'>
